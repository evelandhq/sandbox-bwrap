{
  "name": "@evelandhq/sandbox-bwrap",
  "version": "0.3.0",
  "description": "bubblewrap SandboxBackend for eve agents — real exec sandboxing without Docker or KVM",
  "keywords": [
    "agent",
    "bubblewrap",
    "bwrap",
    "eve",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelandhq/sandbox-bwrap.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "ai": "^7.0.44",
    "eve": "0.47.3",
    "eve-floor": "npm:eve@0.27.13",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "eve": ">=0.27.0 <1.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
